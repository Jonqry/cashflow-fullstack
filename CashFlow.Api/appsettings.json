{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=cashflow.db"
  },
  "Jwt": {
    "Issuer": "CashFlow.Api",
    "Audience": "CashFlow.Web",
    "ExpiracaoMinutos": 60
  },
  "RateLimit": {
    "AuthPermitLimit": 5,
    "AuthJanelaSegundos": 60,
    "GlobalPermitLimit": 100
  },
  "Cors": {
    "Origens": [ "http://localhost:5173" ]
  }
}
